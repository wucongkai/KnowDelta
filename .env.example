# Compatible Chat Completions endpoint; include /v1 when your provider requires it.
KNOWDELTA_LLM_BASE_URL=
KNOWDELTA_LLM_MODEL=
KNOWDELTA_LLM_API_KEY=
# Optional: a separate model ID on the same endpoint for --vision.
KNOWDELTA_VISION_MODEL=
# Optional system FFmpeg override; otherwise use PATH or the bundled binary.
KNOWDELTA_FFMPEG=

# Web services (local development; API and worker use the same configuration).
KNOWDELTA_DATABASE_URL=postgresql+psycopg://knowdelta:knowdelta_local@127.0.0.1:54329/knowdelta
KNOWDELTA_REDIS_URL=redis://127.0.0.1:63799/0
KNOWDELTA_DATA_ROOT=data
KNOWDELTA_API_HOST=127.0.0.1
KNOWDELTA_API_PORT=8000
KNOWDELTA_CORS_ORIGINS=["http://127.0.0.1:5174","http://localhost:5174"]
KNOWDELTA_MAX_UPLOAD_MB=2048
